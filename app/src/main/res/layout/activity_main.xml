<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/coolyellow"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="70dp">

        <TextView
            android:id="@+id/textView7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:textSize="40dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/orbitron"
            android:textColor="@color/brownish"
            android:layout_marginBottom="5dp"
            android:text="INTERACTIVE LEARNING!" />

        <TextView
            android:id="@+id/textView6"
            android:layout_width="581dp"
            android:layout_height="wrap_content"
            android:paddingBottom="25dp"
            android:fontFamily="@font/orbitron"
            android:textColor="@color/brownish"
            android:text="A PLACE OF FUN AND KNOWLEDGE"
            android:textAlignment="center"
            android:textSize="16dp" />

        <TextView
            android:id="@+id/textView5"
            android:layout_width="356dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lylas_regular"
            android:paddingBottom="12dp"
            android:text="Choose a topic and start learning through a fun mini-game!"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="20dp" />

        <Button
            android:id="@+id/selfEsteemButton"
            android:layout_width="284dp"
            android:layout_height="100dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/button1yellow"
            android:fontFamily="@font/lylas_regular"
            android:text="   ANXIETY"
            android:textColor="@color/black"
            android:textSize="27dp"
            app:strokeColor="#DCDBB0"
            app:strokeWidth="2dp" />

        <Button
            android:id="@+id/anxietyButton"
            android:layout_width="284dp"
            android:layout_height="100dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/button2purple"
            android:fontFamily="@font/lylas_regular"
            android:text="     DEPRESSION"
            android:textColor="@color/black"
            android:textSize="23dp"
            app:strokeColor="#8373B3"
            app:strokeWidth="2dp" />

        <Button
            android:id="@+id/depressionButton"
            android:layout_width="284dp"
            android:layout_height="100dp"
            android:backgroundTint="@color/button3red"
            android:fontFamily="@font/lylas_regular"
            android:text="      SELF-ESTEEM"
            android:textColor="@color/black"
            android:textSize="23dp"
            app:strokeColor="#C1889A"
            app:strokeWidth="2dp" />

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/button_border" />

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="89dp"
            android:layout_height="87dp"
            android:elevation="2dp"
            android:translationX="-97dp"
            android:translationY="-307dp"
            android:visibility="visible"
            app:srcCompat="@drawable/brain_yellow" />

        <ImageView
            android:id="@+id/imageView3"
            android:layout_width="88dp"
            android:layout_height="87dp"
            android:elevation="2dp"
            android:translationX="-97dp"
            android:translationY="-285dp"
            android:visibility="visible"
            app:srcCompat="@drawable/brain_purple" />

        <ImageView
            android:id="@+id/imageView4"
            android:layout_width="84dp"
            android:layout_height="87dp"
            android:elevation="2dp"
            android:translationX="-97dp"
            android:translationY="-265dp"
            android:visibility="visible"
            app:srcCompat="@drawable/brain_red" />

        <ImageView
            android:id="@+id/imageView5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:srcCompat="@android:drawable/btn_star_big_on" />

        <ImageButton
            android:id="@+id/imageButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:srcCompat="@android:drawable/ic_menu_add" />

        <com.google.android.material.chip.ChipGroup
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        </com.google.android.material.chip.ChipGroup>

    </LinearLayout>

